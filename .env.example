# Copy to .env to override defaults. Every setting is listed in src/ragbot/config.py.

# RAGBOT_LLM_MODEL=qwen2.5:3b
# RAGBOT_CONTEXT_MAX_CHUNKS=4
# RAGBOT_MIN_RELEVANCE_LOGIT=-6.0

# Hosted LLM (retrieved passages are then sent to this provider):
# RAGBOT_LLM_PROVIDER=openai
# RAGBOT_LLM_BASE_URL=https://api.groq.com/openai
# RAGBOT_LLM_MODEL=your-model-name
# RAGBOT_LLM_API_KEY=your-key
